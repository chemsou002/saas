<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line client for the service (stand-in for the Phase 5 tray UI; uses the same IPC client). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nightshift.Ctl</RootNamespace>
    <AssemblyName>nightshiftctl</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Nightshift.Poc\CommandLine.cs" Link="CommandLine.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nightshift.Core\Nightshift.Core.csproj" />
    <ProjectReference Include="..\Nightshift.Ipc\Nightshift.Ipc.csproj" />
  </ItemGroup>
</Project>
