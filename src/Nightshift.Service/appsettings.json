{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Nightshift": {
    "PipeName": "NightshiftService.v1",
    "TickMilliseconds": 1000,
    "ServiceHeartbeatSeconds": 10,
    "SessionHeartbeatSeconds": 10,
    "BatteryPollSeconds": 30,
    "AcLossGraceSeconds": 60,
    "DisplayIdleTimeoutSeconds": 60,
    "MaxConsecutiveTickFailures": 5
  }
}
