<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Windows background service that owns NIGHTSHIFT sessions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nightshift.Service</RootNamespace>
    <AssemblyName>Nightshift.Service</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nightshift.Core\Nightshift.Core.csproj" />
    <ProjectReference Include="..\Nightshift.Windows\Nightshift.Windows.csproj" />
    <ProjectReference Include="..\Nightshift.Storage\Nightshift.Storage.csproj" />
    <ProjectReference Include="..\Nightshift.Ipc\Nightshift.Ipc.csproj" />
  </ItemGroup>
</Project>
